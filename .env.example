# ---------------------------------------------------------------------------
# Local development needs none of this. Copy to .env only when you want to
# change something; the app runs on SQLite and the local disk out of the box.
# ---------------------------------------------------------------------------

# Leave empty to run the admin unlocked on your own machine.
# REQUIRED before this is reachable from the internet.
ADMIN_PASSWORD=

# Changing this signs everyone out.
AUTH_SALT=change-me

# ---------------------------------------------------------------------------
# Deployment (Vercel, or anything else without a persistent disk)
# ---------------------------------------------------------------------------

# Postgres connection string — Neon, Vercel Postgres, Supabase.
# Use the POOLED connection string. Without this, a serverless deployment
# refuses to start rather than quietly losing every quotation.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Set automatically when you add a Vercel Blob store to the project.
# Without it, photo uploads are disabled and you paste image URLs instead.
# BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Local storage locations (ignored once DATABASE_URL / Blob are set)
# ---------------------------------------------------------------------------
# DB_PATH=./data/quotations.db
# UPLOAD_DIR=./data/uploads
